# Copy to microduck-x/.env and fill in. Read only by the control service (backend/microduck_x/config.py);
# never by the browser. A variable already set in the environment wins over this file.

# Groq brain (brain.py): off unless a key is set. Create a key at https://console.groq.com/keys
GROQ_API_KEY=replace_with_your_new_key
GROQ_MODEL=openai/gpt-oss-120b

# Optional tuning (defaults shown)
# GROQ_REASONING_EFFORT=medium        # low | medium | high
# GROQ_TEMPERATURE=1
# GROQ_MAX_COMPLETION_TOKENS=2048
# GROQ_TIMEOUT_S=30
# GROQ_HISTORY_MESSAGES=16            # conversation kept per chat session (user + duck messages)
# GROQ_HISTORY_CHARS=16000            # and at most this many characters of it
# GROQ_RATE_PER_MIN=20                # questions to Groq per minute, all sessions together
# GROQ_WEB_SEARCH=0                   # 1: let the duck look things up with Groq's browser search
# MDX_CHAT_MAX_CHARS=2000             # longest chat message accepted

# ── Hosted demo (Dockerfile, render.yaml) ───────────────────────────────────────────────────────
# Set in the host's dashboard, not in a committed file. The Dockerfile already sets MDX_MOCK=1 and
# MDX_HOST=0.0.0.0; the port comes from the host's PORT (MDX_PORT overrides it).
# MDX_TOKEN=a-long-random-string     # required for any non-local bind; open the page as /?token=...
# MDX_MOCK=1                          # the mock robot: no MuJoCo, no robotd (not the Microduck)
# MDX_HOST=0.0.0.0
# PORT=10000                          # set by Render; locally the default is 8765
